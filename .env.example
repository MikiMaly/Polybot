# Zkopíruj jako .env a doplň hodnoty — .env NIKDY necommituj!

# OpenRouter API klíč (zdarma na openrouter.ai)
OPENROUTER_API_KEY=<vloz_svuj_klic_z_openrouter.ai>

# Lokální dashboard (spusť: uvicorn dashboard.server:app --port 8001)
HUB_API_URL=http://localhost:8001/api/signals
HUB_BOT_SECRET=local_secret
